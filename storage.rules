rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Allow anyone to read user uploads
    match /user-uploads/{imageId} {
      allow read: if true;
      allow write: if request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
